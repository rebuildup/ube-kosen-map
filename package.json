{
  "name": "ube-kosen-map",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:templates": "node --test templates/",
    "check:data": "node quality/check-data-integrity.mts",
    "validate:fast": "bun run typecheck && bun run lint && bun run test && bun run format:check && bun run check:data",
    "validate:integration": "bun run validate:fast && bun run test:templates && bun run build",
    "validate:release": "bun run validate:integration && node .agents/skills/system-quality/scripts/challenge.mts . quality/challenge-suite.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "lucide-react": "^0.545.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^4.1.10",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.1",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "prettier": "^3.10.1",
    "typescript": "~5.3.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.3.5",
    "vitest": "^5.1.1"
  }
}
